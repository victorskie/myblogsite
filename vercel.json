{
  "builds": [
    {
      "src": "blogsite/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "blogsite/wsgi.py"
    }
  ],
  "env": {
    "PYTHON_VERSION": "3.12"
  }
}